<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaikeronLauncher</AssemblyName>
    <RootNamespace>Taikeron.Launcher</RootNamespace>
    <Version>0.4.15</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TaikeronLauncher.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\TaikeronLabMark.png" />
    <Resource Include="Assets\TaikeronMapBuilderMark.png" />
    <Resource Include="Assets\TaikeronLauncher.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Taikeron.Shared\TlRuntimeCleanup.cs" Link="Services\TlRuntimeCleanup.cs" />
  </ItemGroup>
</Project>
