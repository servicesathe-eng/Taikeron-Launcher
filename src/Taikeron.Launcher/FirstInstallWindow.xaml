<Window x:Class="Taikeron.Launcher.FirstInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taikeron — Première installation"
        Width="760" Height="560"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">
    <Window.Resources>
        <Style TargetType="TextBox" x:Key="PathBox">
            <Setter Property="Background" Value="#081924"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="#3B5060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Préparer Taikeron Lab" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="Avant la première installation, choisis où Taikeron doit stocker le code et tes données."
                       Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="9" Padding="18">
            <StackPanel>
                <TextBlock Text="1 · Applications" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="TL et les autres applications Windows seront installés ici. Ce dossier contient uniquement du code remplaçable."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,7" TextWrapping="Wrap"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="AppsRootBox" Style="{StaticResource PathBox}"/>
                    <Button Grid.Column="2" Content="Parcourir" Style="{StaticResource ActionButton}" Padding="14,8" Click="BrowseApps_Click"/>
                </Grid>

                <TextBlock Text="2 · Données personnelles" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Profils, historique, réglages et coffre local resteront ici, séparés du code de TL."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,7" TextWrapping="Wrap"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="VaultRootBox" Style="{StaticResource PathBox}"/>
                    <Button Grid.Column="2" Content="Parcourir" Style="{StaticResource ActionButton}" Padding="14,8" Click="BrowseVault_Click"/>
                </Grid>

                <TextBlock Text="3 · Cartes" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Les TaikerMap peuvent être stockées sur un autre disque si elles occupent beaucoup d’espace."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,7" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="MapsRootBox" Style="{StaticResource PathBox}"/>
                    <Button Grid.Column="2" Content="Parcourir" Style="{StaticResource ActionButton}" Padding="14,8" Click="BrowseMaps_Click"/>
                </Grid>

                <Border Background="#081924" BorderBrush="#304858" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,0">
                    <TextBlock Text="Le Launcher ne supprimera jamais le dossier de données lors d’une mise à jour ou d’une réparation de TL."
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tu pourras modifier ces emplacements plus tard dans Paramètres."
                       Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Annuler" Style="{StaticResource ActionButton}" Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="Enregistrer et installer TL" Style="{StaticResource GoldButton}" Click="Continue_Click"/>
        </Grid>
    </Grid>
</Window>
