<Application x:Class="Taikeron.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="BgColor">#07141E</Color>
        <Color x:Key="PanelColor">#0A1B27</Color>
        <Color x:Key="PanelAltColor">#0D2230</Color>
        <Color x:Key="GoldColor">#E3AF1D</Color>
        <Color x:Key="GoldBrightColor">#F6C948</Color>
        <Color x:Key="TextColor">#F4F5F6</Color>
        <Color x:Key="MutedColor">#9AA7B2</Color>
        <Color x:Key="GreenColor">#20D77A</Color>
        <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelAlt" Color="{StaticResource PanelAltColor}"/>
        <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}"/>
        <SolidColorBrush x:Key="GoldBright" Color="{StaticResource GoldBrightColor}"/>
        <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource PanelAlt}"/>
            <Setter Property="BorderBrush" Value="#596B78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="GoldButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource GoldBright}"/>
            <Setter Property="Foreground" Value="#09131A"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBright}"/>
        </Style>
    </Application.Resources>
</Application>
