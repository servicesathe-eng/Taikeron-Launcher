<Window x:Class="Taikeron.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taikeron Launcher"
        Width="1080" Height="650"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#06131D" BorderBrush="#263746" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="7" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#0B1B26">
                        <TextBlock Text="TL" Foreground="{StaticResource GoldBright}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TAIKERON" FontWeight="SemiBold" FontSize="19" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⌂  Accueil" Style="{StaticResource ActionButton}" BorderBrush="{StaticResource Gold}" Margin="0,0,8,0" Padding="15,8"/>
                    <Button Content="↓  Mises à jour  •1" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Padding="15,8" Click="RefreshButton_Click"/>
                    <Button Content="⌕  Réparation" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Padding="15,8" Click="RepairButton_Click"/>
                    <Button Content="⚙  Paramètres" Style="{StaticResource ActionButton}" Padding="15,8" Click="SettingsButton_Click"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="v0.1.0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="9" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#16271E" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="7" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#0A1720">
                                <TextBlock Text="TL" Foreground="{StaticResource GoldBright}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Taikeron Lab (TL)" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Parcours cyclistes" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#091923" BorderBrush="#253B49" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="7" BorderBrush="#566774" BorderThickness="1">
                                <TextBlock Text="MAP" Foreground="{StaticResource GoldBright}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Taikeron Map Builder (TMB)" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="Cartes et itinéraires" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="#091923" BorderBrush="#253B49" BorderThickness="1" CornerRadius="7" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" BorderBrush="#7C8993" BorderThickness="1">
                                <TextBlock Text="+" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Bientôt plus d’outils" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="L’écosystème s’agrandit" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="8,16,8,8">
                        <Separator Background="{StaticResource Gold}" Margin="0,0,0,12"/>
                        <TextBlock Text="PLUS LOIN" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="AVEC VOS PARCOURS" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#283C4A" BorderThickness="1" CornerRadius="9" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="76" Height="76" CornerRadius="12" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#091923">
                            <TextBlock Text="TL" Foreground="{StaticResource GoldBright}" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Taikeron Lab (TL)" FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock Text="Création, édition et analyse de parcours cyclistes." FontSize="16" Margin="0,5,0,0"/>
                            <TextBlock Text="Le launcher devient le point d’entrée, de mise à jour et de réparation de TL." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,17,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="13" Height="13" Fill="{StaticResource Green}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="Détection…" Foreground="{StaticResource Green}" FontWeight="SemiBold" FontSize="15"/>
                            <Border x:Name="UpdateBadge" Margin="18,-4,0,0" Padding="10,4" CornerRadius="12" BorderBrush="{StaticResource Gold}" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock x:Name="UpdateBadgeText" Text="Mise à jour disponible" Foreground="{StaticResource GoldBright}" FontSize="12"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Version installée : " Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="InstalledVersionText" Text="—" FontWeight="SemiBold"/>
                            <TextBlock Text="    |    Dernière version : " Foreground="{StaticResource Muted}" Margin="10,0,0,0"/>
                            <TextBlock x:Name="LatestVersionText" Text="—" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="InstallPathText" Text="Recherche de l’installation…" Foreground="#718290" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LaunchButton" Grid.Column="0" Content="▶  Lancer" Style="{StaticResource GoldButton}" Click="LaunchButton_Click"/>
                        <Button x:Name="UpdateButton" Grid.Column="2" Content="↓  Mettre à jour" Style="{StaticResource ActionButton}" Click="UpdateButton_Click"/>
                        <Button Grid.Column="4" Content="⌕  Réparer" Style="{StaticResource ActionButton}" Click="RepairButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.05*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#091923" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="7" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Version" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock x:Name="VersionCardValue" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8"/>
                                <TextBlock x:Name="DownloadSizeText" Text="Taille : —" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock x:Name="VersionDateText" Text="Publication : —" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#091923" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="7" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Nouveautés principales" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="• Distribution centralisée par le launcher" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="• Vérification taille + SHA-256" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="• Préparation du remplacement complet de TL" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#091923" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="7" Padding="14">
                            <StackPanel>
                                <TextBlock Text="✓" Foreground="{StaticResource Green}" FontSize="27" FontWeight="Bold"/>
                                <TextBlock x:Name="ShaStatusText" Text="SHA-256 du manifeste" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0"/>
                                <TextBlock Text="Le paquet téléchargé doit correspondre exactement au manifeste avant toute installation." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,18,0,0">
                        <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource GoldBright}" Background="#20313E" Visibility="Collapsed"/>
                        <TextBlock x:Name="ActivityText" Text="Prêt." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="5" BorderBrush="#263B49" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="◉  Canal stable" Foreground="{StaticResource Muted}"/>
                            <TextBlock Grid.Column="1" Text="✓  Installation vérifiée" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="◉  Données séparées du code" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
